# Safe defaults keep the router in observe-only mode.
MODEL_ROUTER_MODE=shadow
MODEL_ROUTER_SHADOW_TARGET=capable
MODEL_ROUTER_MAX_BODY_BYTES=1048576
MODEL_ROUTER_FALLBACK_ON_ERROR=0
MODEL_ROUTER_AUDIT_PATH=-
MODEL_ROUTER_CLASSIFIER_MODE=hybrid
MODEL_ROUTER_COMPLEXITY_POLICY=adaptive
MODEL_ROUTER_UNDERROUTE_TOLERANCE=0.15
MODEL_ROUTER_ADAPTIVE_CONFIDENCE_THRESHOLD=0.45
MODEL_ROUTER_ARTIFACT=model_router/artifacts/complexity_router_v3.npz

# Enforcement mode refuses to start unless every gate in these files passes.
MODEL_ROUTER_RELEASE_POLICY=config/release_policy.json
MODEL_ROUTER_TRAINING_REPORT=reports/complexity_router_v3.json
MODEL_ROUTER_LIVE_SUMMARY=reports/live_eval_summary.json
MODEL_ROUTER_PRICING_REPORT=reports/pricing_verification.json
MODEL_ROUTER_EXTERNAL_DATASET_EVIDENCE=reports/external_dataset_evidence.json
MODEL_ROUTER_METAMORPHIC_REPORT=reports/metamorphic_routing_eval.json
MODEL_ROUTER_SWITCHYARD_CONTRACT_REPORT=reports/switchyard_contract.json
MODEL_ROUTER_WORKLOAD_EVIDENCE=reports/workload_evidence.json
MODEL_ROUTER_LIVE_POLICY_COMPARISON=reports/live_policy_comparison.json

# Supply these through a secret manager; never commit real values.
MODEL_ROUTER_API_TOKEN=replace-me
MODEL_ROUTER_METRICS_TOKEN=replace-me
MODEL_ROUTER_AUDIT_HMAC_KEY=replace-me
SWITCHYARD_API_KEY=replace-me
SWITCHYARD_REVISION=1fc9ab887d1c663b0048ae24d5f473d15ed8daaa

SWITCHYARD_URL=http://switchyard:4000
SWITCHYARD_TIMEOUT_SECONDS=120
